# Local Realistic NiaH exports and release bundles. Keep these in local/Drive
# archives; do not commit raw responses or duplicated packaged results.
exports/
versions/

# Generated V1 analysis/report trees. Reusable analysis code should be curated
# into src/ or scripts/ before it is intentionally committed.
reports/niah_eight_model_report_*/
reports/qwen_query_last_mode_specific_empirical_law_*/
reports/generated/
reports/*_diagnostic/

# Generated Realistic NiaH analysis releases contain request-level tables,
# rendered reports, figures, and copied build scripts. Keep the complete
# release local/Drive rather than committing any part of the report tree.
reports/
report/

# Machine-local scratch, downloaded snapshots, resumable GPU captures, and
# temporary audits. Durable code belongs in src/, scripts/, tests/, or infra/;
# curated results belong in reports/. Force-add from work/ only after review.
/work/

